# SeeMe Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git

# ===================================
# DATABASE CONFIGURATION
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seeme_dev
DB_USER=seeme
DB_PASSWORD=your_secure_password_here

# ===================================
# MONGODB
# ===================================
MONGODB_URI=mongodb://localhost:27017/seeme
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/seeme

# ===================================
# REDIS
# ===================================
REDIS_URL=redis://localhost:6379

# ===================================
# RABBITMQ
# ===================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ===================================
# AWS S3 CONFIGURATION
# ===================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
S3_BUCKET=seeme-images-dev
CLOUDFRONT_URL=https://your-cloudfront-distribution.cloudfront.net

# ===================================
# FIREBASE AUTHENTICATION
# ===================================
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=your_client_email_here

# ===================================
# APPLICATION CONFIGURATION
# ===================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:19006

# ===================================
# SECURITY
# ===================================
# Generate a secure random string (minimum 32 characters)
JWT_SECRET=your_jwt_secret_minimum_32_characters_change_this
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ===================================
# ML SERVICE
# ===================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=your_ml_api_key_here

# ===================================
# RATE LIMITING
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# FILE UPLOAD
# ===================================
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=debug
